NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Where the FastAPI service runs (proxied as /api/v1)
API_URL=http://localhost:8000
# Focus rooms connect straight to the API (WebSockets skip the /api/v1 proxy)
NEXT_PUBLIC_API_WS_URL=ws://localhost:8000
