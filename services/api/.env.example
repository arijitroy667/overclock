# Clerk JWKS URL (dashboard.clerk.com → API Keys), e.g. https://<app>.clerk.accounts.dev/.well-known/jwks.json
CLERK_JWKS_URL=

# Gemini 3.6 Flash (Task Alchemy reframing)
GEMINI_API_KEY=

DATABASE_URL=postgresql+asyncpg://overclock:overclock@localhost:5433/overclock
REDIS_URL=redis://localhost:6379/0

# Web origins allowed to send Clerk tokens (comma-separated)
CLERK_AUTHORIZED_PARTIES=http://localhost:3000
